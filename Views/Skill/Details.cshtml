@model PortfolioMVC.Models.Skill

<style>

    body {
        background: #0f172a;
    }

    /* Hero Section */
    .skill-hero {
        text-align: center;
        padding-top: 70px;
    }

    .skill-title {
        font-size: 2.7rem;
        font-weight: 700;
    }

    .skill-subtitle {
        color: #94a3b8;
        font-size: 1.05rem;
        margin-top: 14px;
    }

    /* Questions Wrapper */
    .question-wrapper {
        max-width: 950px;
        margin: auto;
    }

    .section-heading {
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    /* Accordion */
    .accordion-item {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08) !important;
        border-radius: 18px !important;
        overflow: hidden;
        transition: 0.3s ease;
    }

        .accordion-item:hover {
            transform: translateY(-2px);
        }

    .accordion-button {
        background: transparent !important;
        color: white !important;
        padding: 1.25rem 1.4rem;
        border: none;
        font-size: 1rem;
    }

        .accordion-button:not(.collapsed) {
            background: rgba(255,255,255,0.04) !important;
            color: #38bdf8 !important;
            box-shadow: none;
        }

        .accordion-button:focus {
            box-shadow: none;
        }

        .accordion-button::after {
            filter: brightness(0) invert(1);
        }

    .accordion-body {
        background: rgba(255,255,255,0.02);
        color: #d1d5db;
        line-height: 1.9;
        font-size: 0.97rem;
        padding: 1.5rem;
    }

    .question-number {
        color: #38bdf8;
        font-weight: 700;
        margin-right: 10px;
        min-width: 50px;
    }

    .back-btn {
        border-radius: 12px;
        padding: 10px 22px;
    }

</style>
<!-- HERO -->
<section class="skill-hero container">

    <h1 class="skill-title">
        @Model.Name Interview Preparation
    </h1>

    <p class="skill-subtitle">
        Explore commonly asked interview questions and detailed answers.
    </p>

    <div class="mt-4">
        <a href="javascript:history.back()"
           class="btn btn-outline-light back-btn">

            <i class="bi bi-arrow-left"></i>
            Back to Skills

        </a>
    </div>

</section>

@if (Model.Questions != null && Model.Questions.Any())
{
    <section class="mt-5 pb-5">

        <div class="question-wrapper">

            <h2 class="text-info text-center mb-5 section-heading">
                Interview Questions
            </h2>
            @if (User.IsInRole("Admin"))
            {
                <div class="text-end mb-4">

                    <a asp-controller="Question"
                       asp-action="Create"
                       asp-route-skillId="@Model.Id"
                       class="btn btn-info">

                        <i class="bi bi-plus-circle"></i>
                        Add Question

                    </a>

                </div>
            }

            <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">

                <!-- SEARCH -->
                <div style="flex:1; min-width:250px;">

                    <input type="text"
                           id="questionSearch"
                           class="form-control bg-dark text-light border-secondary"
                           placeholder="Search interview questions..." />

                </div>

                <!-- ADMIN TOGGLE -->
                @if (User.IsInRole("Admin"))
                {
                    <button class="btn btn-outline-info"
                            type="button"
                            onclick="toggleAdminActions()">

                        <i class="bi bi-gear"></i>
                        Toggle Admin Controls

                    </button>
                }

            </div>
            <div class="accordion" id="questionAccordion">

                @foreach (var q in Model.Questions.OrderBy(q => q.OrderNo))
                {
                    <div class="accordion-item mb-4">

                        <h2 class="accordion-header">

                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#question-@q.Id">

                                <div class="d-flex align-items-center w-100">

                                    <span class="question-number">
                                        Q @q.OrderNo
                                    </span>

                                    <span class="fw-semibold">
                                        @q.QuestionText
                                    </span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="ms-auto me-4 d-none admin-actions">

                                            <a asp-controller="Question"
                                               asp-action="Edit"
                                               asp-route-id="@q.Id"
                                               class="btn btn-sm btn-warning me-2"
                                               onclick="event.stopPropagation();">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-controller="Question"
                                               asp-action="Delete"
                                               asp-route-id="@q.Id"
                                               class="btn btn-sm btn-danger"
                                               onclick="event.stopPropagation();">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>
                                    }
                                </div>

                            </button>

                        </h2>

                        <div id="question-@q.Id"
                             class="accordion-collapse collapse"
                             data-bs-parent="#questionAccordion">

                            <div class="accordion-body">

                                <pre class="mb-0 text-light"
                                     style="white-space: pre-wrap; font-family: inherit;">

        @q.AnswerText

            </pre>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </section>
}

<script>

    // SEARCH FILTER
    document.getElementById("questionSearch")
        .addEventListener("keyup", function () {

            let value = this.value.toLowerCase();

            document.querySelectorAll(".accordion-item")
                .forEach(item => {

                    let text = item.innerText.toLowerCase();

                    item.style.display =
                        text.includes(value)
                        ? ""
                        : "none";
                });
        });

    // TOGGLE ADMIN CONTROLS
    function toggleAdminActions() {

        document.querySelectorAll(".admin-actions")
            .forEach(el => {

                el.classList.toggle("d-none");
            });
    }

</script>